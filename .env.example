# =========================================================
# VPS Node Connection Configuration (Main Brain VPS)
# =========================================================
# Enter your Main VPS IP address or ngrok domain here
REDIS_HOST=your-main-vps-ip-or-domain.com
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================================================
# GPU Server REST API Configuration
# =========================================================
VANITY_API_KEY=your_secret_api_key_12345

# Path to the C++ OpenCL Profanity or ProVanity binary
# Linux Vast.ai: /workspace/profanity.x64
# Windows Local: C:\Users\CHAND COMPUTER\Desktop\Tron\tools\profanity_windows\windows\profanity.exe
PROFANITY_BINARY=/workspace/profanity.x64

# Skip device index (0 on Linux Vast.ai, 1 on Windows with integrated GPU)
GPU_SKIP_DEVICE=0
PROVANITY_DEVICES=all

# Server bind address/port
HOST=0.0.0.0
PORT=8000

# Safety cap: max seconds a single job may run
MAX_RUNTIME_SECONDS=259200
PROVANITY_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
MAX_JOBS_HISTORY=500
