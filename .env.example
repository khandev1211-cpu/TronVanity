# =========================================================
# GPU Server Configuration
# =========================================================
# Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# The SAME key must be configured on the client side so the
# two machines can authenticate with each other.
# =========================================================

VANITY_API_KEY=REPLACE_WITH_GENERATED_KEY

# Path to the ProVanity binary on this GPU instance
PROVANITY_BINARY=/workspace/provanity

# CUDA devices to use ("all" or comma-separated ids like "0,1")
PROVANITY_DEVICES=all

# Server bind address/port
HOST=0.0.0.0
PORT=8000

# Safety cap: max seconds a single job may run before it's marked as failed
# Default: 3 days
MAX_RUNTIME_SECONDS=259200

# Max seconds to wait for a single ProVanity subprocess run before treating
# it as stuck/hung and retrying
PROVANITY_TIMEOUT_SECONDS=3600

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# How many recent jobs to return from GET /jobs
MAX_JOBS_HISTORY=500
